pipeline {
  agent {
    docker {
      image 'cimg/node:20.14'
      reuseNode true
      args '-u 0:0 -v /var/run/docker.sock:/var/run/docker.sock -e HOME=.'
    }
  }

  options { }

  parameters {
    string(name: 'GHCR_NAMESPACE', defaultValue: 'BennyBach1002', description: 'GitHub user/org (lowercase for Docker)')
    string(name: 'BRANCH_TO_BUILD', defaultValue: 'unit_testing', description: 'Git branch to build')
    string(name: 'DEPLOY_IMIT', defaultValue: 'localhost', description: 'Ansible --limit (use localhost to deploy on Jenkins host)')
    booleanParam(name: 'DEPLOY_MONITORING', defaultValue: false, description: 'Deploy Prometheus & Grafana monitoring stack')
    string(name: 'PROM_HOST_PORT', defaultValue: '9091', description: 'Host port to expose Prometheus UI')
    string(name: 'PUBLIC_HOST', defaultValue: '54.163.245.207', description: 'Public IP/DNS của Jenkins host để tạo link Prometheus/Grafana')
  }

  environment {
    APP_NAME = 'rmit-store'
    BACKEND_IMAGE  = "ghcr.io/${params.GHCR_NAMESPACE}/rmit-store-backend"
    FRONTEND_IMAGE = "ghcr.io/${params.GHCR_NAMESPACE}/rmit-store-frontend"
    DB_IMAGE       = "ghcr.io/${params.GHCR_NAMESPACE}/rmit-store-db"
    DOCKER_EC2_IP  = '54.242.180.228'
    SSH_CREDENTIAL_ID = 'long-docker-ec2-key'
    GHCR_USER = 'apotato4325'
    PLAYBOOK = '/home/ec2-user/prod/infra/ansible/site.yml'
    INVENTORY = '/home/ec2-user/prod/infra/ansible/inventory.ini'
    // Không cần WS_DIR nữa
  }

  stages {
    // Stage 'Checkout' không cần thiết nữa vì Jenkins sẽ tự động làm
    
    stage('Unit Tests') {
      parallel {
        stage('Frontend: Unit Tests') {
          steps {
            // Chạy trực tiếp trong thư mục 'client'
            dir('client') {
              sh '''#!/bin/bash
                set -euo pipefail
                echo "🔧 FE pre-clean..."
                rm -rf node_modules
                mkdir -p .npm .puppeteer-cache
                export npm_config_cache="$PWD/.npm"
                export PUPPETEER_CACHE_DIR="$PWD/.puppeteer-cache"
                export PUPPETEER_DOWNLOAD_PATH="$PWD/.puppeteer-cache"

                echo "📦 FE install..."
                npm install --no-audit --no-fund --prefer-offline

                echo "🧪 FE unit tests..."
                npm test -- --ci --runInBand
              '''
            }
          }
        }
        stage('Backend: Unit Tests') {
          steps {
            dir('server') {
              sh '''#!/bin/bash
                set -euo pipefail
                echo "🔧 BE pre-clean..."
                rm -rf node_modules
                mkdir -p .npm
                export npm_config_cache="$PWD/.npm"

                echo "📦 BE install..."
                npm install --no-audit --no-fund --prefer-offline

                echo "🧪 BE unit tests..."
                npm test -- --ci --runInBand
              '''
            }
          }
        }
      }
    }

    stage('Deploy Monitoring (CI host)') {
      when { expression { return params.DEPLOY_MONITORING } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          COMPOSE_FILE="${WORKSPACE}/compose/monitoring/docker-compose.yml"
          [ -f "$COMPOSE_FILE" ] || { echo "[ERROR] Missing $COMPOSE_FILE"; ls -la "${WORKSPACE}/compose/monitoring" || true; exit 1; }
        '''
      }
    }
  
    stage('Build & Push Images') {
        steps {
            withCredentials([string(credentialsId: 'long-GHRC_PAT', variable: 'GH_TOKEN')]) {
                sh '''
                    # Đảm bảo workspace là an toàn cho Git
                    git config --global --add safe.directory "$WORKSPACE"

                    echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin

                    IMAGE_TAG=$(git rev-parse --short HEAD)

                    # Build backend từ thư mục gốc, chỉ định Dockerfile
                    docker build -t ${BACKEND_IMAGE}:$IMAGE_TAG -f ci/Dockerfile.backend .
                    docker tag ${BACKEND_IMAGE}:$IMAGE_TAG ${BACKEND_IMAGE}:latest
                    docker push ${BACKEND_IMAGE}:$IMAGE_TAG
                    docker push ${BACKEND_IMAGE}:latest

                    # Build frontend từ thư mục gốc, chỉ định Dockerfile
                    docker build -t ${FRONTEND_IMAGE}:$IMAGE_TAG -f ci/Dockerfile.frontend .
                    docker tag ${FRONTEND_IMAGE}:$IMAGE_TAG ${FRONTEND_IMAGE}:latest
                    docker push ${FRONTEND_IMAGE}:$IMAGE_TAG
                    docker push ${FRONTEND_IMAGE}:latest

                    docker pull mongo:6
                    docker tag mongo:6 ${DB_IMAGE}:$IMAGE_TAG
                    docker tag mongo:6 ${DB_IMAGE}:latest
                    docker push ${DB_IMAGE}:$IMAGE_TAG
                    docker push ${DB_IMAGE}:latest
                '''
            }
        }
    }

    stage('Test SSH to EC2') {
      steps {
        sshagent(credentials: [SSH_CREDENTIAL_ID]) {
          sh "ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} 'echo ✅ Connected via Jenkins'"
        }
      }
    }

    stage('Deploy to EC2 (Docker Swarm)') {
      steps {
        sshagent(credentials: [SSH_CREDENTIAL_ID]) {
          withCredentials([string(credentialsId: 'long-GHRC_PAT', variable: 'GH_TOKEN')]) {
            sh """
                ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} '
                    echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin || true
                    cd /home/ec2-user/prod/compose/staging || exit 1
                    docker swarm init --advertise-addr ${DOCKER_EC2_IP} || true
                    docker stack rm mystack || true
                    sleep 10
                    docker stack deploy -c docker-stack.yml mystack --with-registry-auth
                    docker stack services mystack
                '
            """
          }
        }
      }
    }

    stage('Deploy with Ansible on EC2') {
      steps {
        sshagent(credentials: [SSH_CREDENTIAL_ID]) {
          withCredentials([string(credentialsId: 'long-GHRC_PAT', variable: 'GH_TOKEN')]) {
            sh '''
                git config --global --add safe.directory "$WORKSPACE"

                echo "$GH_TOKEN" | docker login ghcr.io -u $GHCR_USER --password-stdin || true

                export ANSIBLE_STDOUT_CALLBACK=yaml
                export ANSIBLE_HOST_KEY_CHECKING=False
                export ANSIBLE_SSH_ARGS='-o ForwardAgent=yes -o StrictHostKeyChecking=no'

                # Các đường dẫn đã là tương đối với workspace
                ansible-playbook \
                    -i infra/ansible/inventory.ini infra/ansible/site.yml \
                    -e "frontend_image=${FRONTEND_IMAGE}" \
                    -e "backend_image=${BACKEND_IMAGE}" \
                    -e "db_image=${DB_IMAGE}" \
                    -e "image_tag=$(git rev-parse --short HEAD)" \
                    -e "app_name=${APP_NAME}" \
                    -e "env=staging" \
                    -e "ghcr_user=${GHCR_USER}" \
                    -e "ghcr_token=${GH_TOKEN}"
            '''
          }
        }
      }
    }
  }

  post {
    success { echo "✅ ${APP_NAME} built, pushed, and deployed via Ansible on ${DOCKER_EC2_IP}" }
    failure { echo "❌ Deployment failed" }
  }
}