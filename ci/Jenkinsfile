pipeline {
    agent any

    parameters {
        string(name: 'GHCR_NAMESPACE',  defaultValue: 'apotato4325', description: 'GHCR namespace (user/org)')
        string(name: 'BRANCH_TO_BUILD', defaultValue: 'docker',      description: 'Git branch to build')
    }

    environment {
        APP_NAME = 'rmit-store'

        GHCR_USER      = 'apotato4325'
        BACKEND_IMAGE  = "ghcr.io/${params.GHCR_NAMESPACE}/rmit-store-backend"
        FRONTEND_IMAGE = "ghcr.io/${params.GHCR_NAMESPACE}/rmit-store-frontend"

        // You’re on Atlas, so no DB image is needed. Keeping the var for compatibility.
        DB_IMAGE       = "ghcr.io/${params.GHCR_NAMESPACE}/rmit-store-db"

        DOCKER_EC2_IP      = '54.242.180.228'
        SSH_CREDENTIAL_ID  = 'long-docker-ec2-key'
        GHCR_PAT_CRED_ID   = 'long-GHRC_PAT'

        // Ansible
        PLAYBOOK  = '/home/ec2-user/prod/infra/ansible/site.yml'
        INVENTORY = '/home/ec2-user/prod/infra/ansible/inventory.ini'

        // Frontend → Backend URL (baked at build time)
        FRONTEND_API_URL = "http://${DOCKER_EC2_IP}:3000/api"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH_TO_BUILD}",
                    credentialsId: 'long-github-creds',
                    url: 'https://github.com/APotato4325/rmit-store-backend_frontend.git'
            }
        }

        stage('Build & Push Images') {
            steps {
                withCredentials([string(credentialsId: GHCR_PAT_CRED_ID, variable: 'GH_TOKEN')]) {
                    sh """
                        set -euxo pipefail

                        echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin
                        IMAGE_TAG=\$(git rev-parse --short HEAD)

                        # ===== Backend =====
                        docker build \
                          -t ${BACKEND_IMAGE}:\$IMAGE_TAG \
                          -t ${BACKEND_IMAGE}:latest \
                          -f ci/Dockerfile.backend .

                        docker push ${BACKEND_IMAGE}:\$IMAGE_TAG
                        docker push ${BACKEND_IMAGE}:latest

                        # ===== Frontend (bake API URL) =====
                        docker build \
                          --build-arg REACT_APP_API_URL=${FRONTEND_API_URL} \
                          -t ${FRONTEND_IMAGE}:\$IMAGE_TAG \
                          -t ${FRONTEND_IMAGE}:latest \
                          -f ci/Dockerfile.frontend .

                        docker push ${FRONTEND_IMAGE}:\$IMAGE_TAG
                        docker push ${FRONTEND_IMAGE}:latest

                        # ===== OPTIONAL: DB image (not used with Atlas). Keep for now. =====
                        docker pull mongo:6
                        docker tag  mongo:6 ${DB_IMAGE}:\$IMAGE_TAG
                        docker tag  mongo:6 ${DB_IMAGE}:latest
                        docker push ${DB_IMAGE}:\$IMAGE_TAG
                        docker push ${DB_IMAGE}:latest
                    """
                }
            }
        }

        stage('Test SSH to EC2') {
            steps {
                sshagent(credentials: [SSH_CREDENTIAL_ID]) {
                    sh "ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} 'echo ✅ Connected via Jenkins'"
                }
            }
        }

        stage('Deploy to EC2 (Docker Swarm)') {
            steps {
                sshagent(credentials: [SSH_CREDENTIAL_ID]) {
                    withCredentials([string(credentialsId: GHCR_PAT_CRED_ID, variable: 'GH_TOKEN')]) {
                        sh """
                            set -euxo pipefail
                            ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} '
                                echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin || true

                                cd /home/ec2-user/prod/compose/staging || exit 1

                                # Initialize swarm (idempotent)
                                docker swarm init --advertise-addr ${DOCKER_EC2_IP} || true

                                # Remove old stack (clean deploy)
                                docker stack rm mystack || true
                                sleep 10

                                # Deploy fresh (no Nginx, only your services)
                                docker stack deploy -c docker-stack.yml mystack --with-registry-auth

                                # Show status
                                docker stack services mystack
                            '
                        """
                    }
                }
            }
        }

        stage('Deploy with Ansible on EC2') {
            steps {
                sshagent(credentials: [SSH_CREDENTIAL_ID]) {
                    withCredentials([string(credentialsId: GHCR_PAT_CRED_ID, variable: 'GH_TOKEN')]) {
                        sh """
                            set -euxo pipefail

                            # GHCR login (Ansible tasks pulling images on remote hosts can use this)
                            echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin || true

                            export ANSIBLE_STDOUT_CALLBACK=yaml
                            export ANSIBLE_HOST_KEY_CHECKING=False
                            export ANSIBLE_SSH_ARGS='-o ForwardAgent=yes -o StrictHostKeyChecking=no'

                            # Pass images and meta to Ansible (if your playbook uses them)
                            ansible-playbook \
                              -i ${INVENTORY} ${PLAYBOOK} \
                              -e "frontend_image=${FRONTEND_IMAGE}" \
                              -e "backend_image=${BACKEND_IMAGE}" \
                              -e "db_image=${DB_IMAGE}" \
                              -e "image_tag=\$(git rev-parse --short HEAD)" \
                              -e "app_name=${APP_NAME}" \
                              -e "env=staging" \
                              -e "ghcr_user=${GHCR_USER}" \
                              -e "ghcr_token=${GH_TOKEN}"
                        """
                    }
                }
            }
        }
    }

    post {
        success { echo "✅ ${APP_NAME} built, pushed, and deployed via Swarm + Ansible on ${DOCKER_EC2_IP}" }
        failure { echo "❌ Deployment failed" }
    }
}
