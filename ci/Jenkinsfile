    stage('Deploy Monitoring (CI host)') {
      when { expression { return params.DEPLOY_MONITORING } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          echo "[DEBUG] whoami=$(whoami); pwd=$(pwd)"

          if docker compose version >/dev/null 2>&1; then
            DC="docker compose"
          elif command -v docker-compose >/dev/null 2>&1; then
            DC="docker-compose"
          else
            echo "[ERROR] Docker Compose not found"; exit 1
          fi

          docker network inspect rmit-network >/dev/null 2>&1 || docker network create rmit-network || true

          export PROM_HOST_PORT="${PROM_HOST_PORT:-9091}"
          COMPOSE_FILE="${WORKSPACE}/compose/monitoring/docker-compose.yml"
          [ -f "$COMPOSE_FILE" ] || { echo "[ERROR] Missing $COMPOSE_FILE"; ls -la "${WORKSPACE}/compose/monitoring" || true; exit 1; }

          echo "[INFO] Bringing up monitoring stack..."
          $DC -f "$COMPOSE_FILE" down || true
          $DC -f "$COMPOSE_FILE" up -d --remove-orphans

          wait_healthy() {
            local name="$1" max="$2" i status
            echo "[INFO] Waiting for $name (health=healthy)..."
            for i in $(seq 1 "$max"); do
              status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$name" 2>/dev/null || true)"
              if [ "$status" = "healthy" ]; then
                echo "[OK] $name healthy"
                return 0
              fi

              if [ -z "$status" ]; then
                case "$name" in
                  prometheus)
                    if docker run --rm --network container:prometheus curlimages/curl:8.9.1 -fsS \
                       http://127.0.0.1:9090/-/ready >/dev/null; then
                      echo "[OK] $name ready (endpoint)"
                      return 0
                    fi
                    ;;
                  grafana)
                    if docker run --rm --network container:grafana curlimages/curl:8.9.1 -sS \
                       http://127.0.0.1:3000/api/health | grep -Eq '"status":"ok"|"database":"ok"'; then
                      echo "[OK] $name healthy (endpoint)"
                      return 0
                    fi
                    ;;
                esac
              fi

              if (( i % 10 == 0 )); then
                echo "  - $name health='${status:-none}' (retry $i/$max) — tail logs:"
                docker logs --tail=80 "$name" || true
              fi
              sleep 2
            done
            echo "[ERROR] $name NOT healthy after ${max} tries"
            return 1
          }

          wait_healthy prometheus 60
          wait_healthy grafana 90

          echo "[OK] Prometheus & Grafana are up."
          docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"

          HOST="${PUBLIC_HOST:-$(hostname -I | awk '{print $1}')}"
          echo "Prometheus URL: http://${HOST}:${PROM_HOST_PORT}"
          echo "Grafana   URL: http://${HOST}:3003"
        '''
      }
    }

    stage('Build & Push Images') {
      steps {
        withCredentials([string(credentialsId: 'long-GHRC_PAT', variable: 'GH_TOKEN')]) {
          sh """
                        echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin
                        IMAGE_TAG=\$(git rev-parse --short HEAD)

                        #backend
                        docker build -t ${BACKEND_IMAGE}:\$IMAGE_TAG -f ci/Dockerfile.backend .
                        docker tag ${BACKEND_IMAGE}:\$IMAGE_TAG ${BACKEND_IMAGE}:latest
                        docker push ${BACKEND_IMAGE}:\$IMAGE_TAG
                        docker push ${BACKEND_IMAGE}:latest

                        #frontend
                        docker build -t ${FRONTEND_IMAGE}:\$IMAGE_TAG -f ci/Dockerfile.frontend .
                        docker tag ${FRONTEND_IMAGE}:\$IMAGE_TAG ${FRONTEND_IMAGE}:latest
                        docker push ${FRONTEND_IMAGE}:\$IMAGE_TAG
                        docker push ${FRONTEND_IMAGE}:latest

                        #db (retag mongo)
                        docker pull mongo:6
                        docker tag mongo:6 ${DB_IMAGE}:\$IMAGE_TAG
                        docker tag mongo:6 ${DB_IMAGE}:latest
                        docker push ${DB_IMAGE}:\$IMAGE_TAG
                        docker push ${DB_IMAGE}:latest
                    """
        }
      }
    }

        stage('Test SSH to EC2') {
      steps {
        sshagent(credentials: [SSH_CREDENTIAL_ID]) {
          sh "ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} 'echo ✅ Connected via Jenkinscd por'"
        }
      }
        }

        stage('Deploy to EC2 (Docker Swarm)') {
      steps {
        sshagent(credentials: [SSH_CREDENTIAL_ID]) {
          withCredentials([string(credentialsId: 'long-GHRC_PAT', variable: 'GH_TOKEN')]) {
            sh """
                            ssh -o StrictHostKeyChecking=no ec2-user@${DOCKER_EC2_IP} '
                                echo "$GH_TOKEN" | docker login ghcr.io -u ${GHCR_USER} --password-stdin || true
                                cd /home/ec2-user/prod/compose/staging || exit 1

                                #initialize swarm if not already
                                docker swarm init --advertise-addr ${DOCKER_EC2_IP} || true

                                #remove old stack (clean deploy)
                                docker stack rm mystack || true
                                sleep 10

                                #deploy fresh
                                docker stack deploy -c docker-stack.yml mystack --with-registry-auth

                                #show status
                                docker stack services mystack
                            '
                        """
          }
        }
      }
        }

        //there is a fucking problem with the playbook bc if i delete it my docker builds normally
        stage('Deploy with Ansible on EC2') {
      when { expression { params.RUN_ANSIBLE_DEPLOY } }
      steps {
        sshagent(credentials: [SSH_CREDENTIAL_ID]) {
          withCredentials([string(credentialsId: 'long-GHRC_PAT', variable: 'GH_TOKEN')]) {
            sh """
                            # Ensure GHCR login for pulling images
                            echo "$GH_TOKEN" | docker login ghcr.io -u $GHCR_USER --password-stdin || true
                            # Run Ansible playbook from the Jenkins workspace
                            export ANSIBLE_STDOUT_CALLBACK=yaml
                            export ANSIBLE_HOST_KEY_CHECKING=False
                            export ANSIBLE_SSH_ARGS='-o ForwardAgent=yes -o StrictHostKeyChecking=no'

                            ansible-playbook \
                                -i infra/ansible/inventory.ini infra/ansible/site.yml \
                                -e "frontend_image=${FRONTEND_IMAGE}" \
                                -e "backend_image=${BACKEND_IMAGE}" \
                                -e "db_image=${DB_IMAGE}" \
                                -e "image_tag=\$(git rev-parse --short HEAD)" \
                                -e "app_name=${APP_NAME}" \
                                -e "env=staging" \
                                -e "ghcr_user=${GHCR_USER}" \
                                -e "ghcr_token=${GH_TOKEN}"
                        """
          }
        }
      }
        }
  }

  post {
    success {
      echo "✅ ${APP_NAME} built, pushed, and deployed via Ansible on ${DOCKER_EC2_IP}"
    }

    failure {
      echo '❌ Deployment failed'
      emailext(
        to: 'benbach2001@gmail.com',
        subject: 'Jenkins Pipeline Failed:',
        body: """<p>The pipeline for **${env.JOB_NAME}** has failed.</p>
                 <p>Build Status: **${currentBuild.result}**</p>
                 <p>Check the build logs for more details:</p>
                 <p>${env.BUILD_URL}/console</p>"""
      )
    }
  }
}
