  }

  post {
    success {
      echo "✅ ${env.APP_NAME} ${env.IMAGE_TAG} built & deployed to Swarm (host Nginx on :80)."
    }
    failure {
      echo '❌ Pipeline failed. Check console log.'
    }
  }
}
