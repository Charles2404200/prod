      // expect(responseData.user.email).toBe('test@example.com');
      
      // Vì logic có thể đang nằm trong file route, ta chỉ có thể kiểm tra mock đã được chuẩn bị đúng chưa
      // Ví dụ này giả định bạn sẽ gọi hàm controller.
      expect(User.findById).toHaveBeenCalledTimes(0); // Sẽ là 1 nếu hàm thật được gọi.
    });

    it('should return 404 if user is not found in database', async () => {
        const req = httpMocks.createRequest({
            method: 'GET',
            url: '/api/user/me',
            user: {
              _id: 'nonExistentUserId'
            }
        });
        const res = httpMocks.createResponse();

        // Mock User.findById để trả về null (không tìm thấy)
        User.findById.mockResolvedValue(null);
        
        // Nếu bạn đã tách controller ra hàm riêng (ví dụ: getMe)
