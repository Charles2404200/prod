        lastName: 'User'
      };

      // Giả lập một request có chứa thông tin user (đã qua middleware xác thực)
      const req = httpMocks.createRequest({
        method: 'GET',
        url: '/api/user/me',
        user: { // Middleware 'auth' sẽ gắn object này vào request
          _id: 'testUserId'
        }
      });
      
      const res = httpMocks.createResponse();

      // Mock User.findById để trả về người dùng giả lập
      User.findById.mockResolvedValue(mockUser);

      // Nếu bạn đã tách controller ra hàm riêng (ví dụ: getMe)
      // await userController.getMe(req, res);

